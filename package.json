{
  "name": "tagledger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tagledger/web",
    "dev:lan": "npm run dev:lan -w @tagledger/web",
    "build": "npm run build -w @tagledger/web",
    "server": "npm run dev -w @tagledger/server",
    "server:start": "npm run start -w @tagledger/server",
    "serve": "npm run build && npm run server:start",
    "ios": "npm run ios -w @tagledger/web",
    "ios:live": "npm run ios:live -w @tagledger/web",
    "macos": "npm run macos -w @tagledger/web",
    "macos:build": "npm run macos:build -w @tagledger/web"
  }
}
